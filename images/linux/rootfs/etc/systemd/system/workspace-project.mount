[Unit]
Description=Tiny Cosmos workspace disk
Requires=dev-disk-by\x2dlabel-tinycosmos\x2dworkspace.device
After=systemd-remount-fs.service dev-disk-by\x2dlabel-tinycosmos\x2dworkspace.device
Before=tinycosmos-guest.service ssh.service docker.service
JobTimeoutSec=30

[Mount]
What=LABEL=tinycosmos-workspace
Where=/workspace/project
Type=ext4
Options=defaults,x-systemd.device-timeout=30s
TimeoutSec=30

[Install]
WantedBy=multi-user.target
